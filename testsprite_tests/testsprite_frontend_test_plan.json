  {
    "id": "TC005",
    "title": "Authenticated user reaches Admin dashboard from Home via Admin Panel link",
    "description": "Verifies that a logged-in user can click Admin Panel from Home and land on the /admin dashboard.",
    "category": "Home and Support Chat",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click on \"Sign in\""
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/admin\""
      },
      {
        "type": "action",
        "description": "Click on \"Home\" or the product logo to return to the home page"
      },
      {
        "type": "action",
        "description": "Click on \"Admin Panel\""
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/admin\""
      }
    ]
  },
