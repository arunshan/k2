  {
    "id": "TC002",
    "title": "Send a basic chat message and see an agent response",
    "description": "Verifies a user can open the chat popup, send a message, and see a response message appear in the chat.",
    "category": "Home and Support Chat",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /"
      },
      {
        "type": "action",
        "description": "Click on the chat widget button to open the chat popup"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Chat input\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"Hi, can you help me with my order status?\" into the chat input"
      },
      {
        "type": "action",
        "description": "Click on \"Send\" in the chat popup"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Hi, can you help me with my order status?\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify an assistant response message is visible in the chat thread"
      }
    ]
  },
