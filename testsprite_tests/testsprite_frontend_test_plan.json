        "description": "Verify text \"Instant Answers\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Smart Actions\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Human Handoff\" is visible"
