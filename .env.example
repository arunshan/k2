# AWS (infra account - for DynamoDB, S3)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock (separate account credentials, optional - falls back to default)
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-west-2
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_SESSION_TOKEN=
BEDROCK_KNOWLEDGE_BASE_ID=

# DynamoDB
DYNAMODB_CONVERSATIONS_TABLE=k2-conversations
DYNAMODB_SESSIONS_TABLE=k2-sessions
DYNAMODB_AUDIT_TABLE=k2-audit-log

# S3
S3_DOCUMENTS_BUCKET=k2-documents

# Auth
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Datadog
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=k2-support-agent
DD_ENV=development

# Slack webhook (optional, for human handoff)
SLACK_WEBHOOK_URL=
